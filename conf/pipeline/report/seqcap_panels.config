/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for SeqCap panel and design paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines reference panels and designs using SeqCap paths.
    Can be customised using:
        params.seqcap_panels_base / --seqcap_panels_base
        params.cnv_database_base  / --cnv_database_base
----------------------------------------------------------------------------------------
*/

params {
    seqcap_panels_base = params.seqcap_panels_base ?: "${params.igenomes_base}/Hsapiens/${params.genome}/regions/SeqCap"
    cnv_database_base  = params.cnv_database_base  ?: "${params.igenomes_base}/Hsapiens/${params.genome}/variation/EOG_CNV"

